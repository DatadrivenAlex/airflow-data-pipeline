# Local demo only. Do not reuse this Fernet key outside a throwaway Airflow stack.
AIRFLOW_UID=50000
FERNET_KEY=6i8Gdc7EqDn7nPa-dfsr3mJ0OgOyzw00ZyeIpLf3qnw=
AIRFLOW_WWW_USER_USERNAME=airflow
AIRFLOW_WWW_USER_PASSWORD=airflow

# The compose stack replays the bundled sample unless this is set to 0.
ELT_OFFLINE=1
ELT_ALLOW_SAMPLE_FALLBACK=1
USGS_MIN_MAGNITUDE=4.5

DUCKDB_PATH=/opt/airflow/data/warehouse/earthquakes.duckdb

# Uncomment, with `docker compose --profile warehouse-postgres up`, to load Postgres
# instead of DuckDB. The Airflow metadata database stays on the other Postgres service.
# WAREHOUSE_URL=postgresql://warehouse:warehouse@warehouse-postgres:5432/warehouse
